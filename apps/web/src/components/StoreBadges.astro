---
// Badges App Store et Google Play. Un badge sans lien (app pas encore publiée
// sur ce store) garde la même apparence mais n'est pas cliquable.
// Les liens se règlent dans src/lib/stores.js.
import { STORES } from '../lib/stores.js';
const Tag = (url) => (url ? 'a' : 'span');
const IosTag = Tag(STORES.ios);
const AndroidTag = Tag(STORES.android);
const ext = { target: '_blank', rel: 'noopener' };
---
<div class="stores">
  <IosTag class:list={['store-badge', { 'is-soon': !STORES.ios }]}
    {...(STORES.ios ? { href: STORES.ios, ...ext } : {})}
    aria-label={STORES.ios ? "Télécharger Zola sur l'App Store" : "Zola sur l'App Store, bientôt disponible"}>
    <svg viewBox="0 0 24 24" fill="#fff" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8.98-.2 1.92-.89 3.16-.8 1.79.14 3.03.86 3.74 2.15-3.28 1.98-2.5 6.32.55 7.54-.62 1.62-1.43 3.21-2.53 3.28zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
    </svg>
    <span class="txt"><span class="small">Télécharger sur</span><span class="big">App Store</span></span>
  </IosTag>
  <AndroidTag class:list={['store-badge', { 'is-soon': !STORES.android }]}
    {...(STORES.android ? { href: STORES.android, ...ext } : {})}
    aria-label={STORES.android ? 'Télécharger Zola sur Google Play' : 'Zola sur Google Play, bientôt disponible'}>
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M3.6 2.3 13.5 12 3.6 21.7c-.4-.2-.6-.6-.6-1.1V3.4c0-.5.2-.9.6-1.1z" fill="#00d7fe"/>
      <path d="m17.1 8.5-3.6 3.5L3.6 2.3c.1-.1.3-.1.4-.1.3 0 .5.1.8.2l12.3 6.1z" fill="#00f076"/>
      <path d="m17.1 15.5-12.3 6.1c-.3.2-.5.2-.8.2-.1 0-.3 0-.4-.1l9.9-9.7 3.6 3.5z" fill="#f43249"/>
      <path d="M21 12c0 .6-.3 1.1-.9 1.4l-3 1.5-3.9-3.4 3.9-3.9 3 1.5c.6.3.9.8.9 1.4z" fill="#ffd500"/>
    </svg>
    <span class="txt"><span class="small">DISPONIBLE SUR</span><span class="big">Google Play</span></span>
  </AndroidTag>
</div>
