// Le bandeau de chiffres affiche un vrai compteur (voir src/lib/counter.js).
import { fetchCounter, counterLabel, formatCount } from '../lib/counter.js';
import { storeNote } from '../lib/stores.js';
import StoreBadges from '../components/StoreBadges.astro';


let counter;
for (let attempt = 1; ; attempt++) {
  try { counter = await fetchCounter(); break; } catch (error) {
    if (attempt >= 4) throw error;
    await new Promise((r) => setTimeout(r, attempt * 2000));
  }
}
