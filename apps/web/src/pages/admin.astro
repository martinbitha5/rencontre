---
// Chemin ABSOLU : ouvert en /admin/ (barre finale), un lien relatif
// cherchait /admin/admin.css (404) et le backoffice s'affichait sans style.
// Le numéro de version change à chaque build : le navigateur et le CDN
// Hostinger ne servent plus une ancienne feuille gardée en cache un jour.
const cssVersion = Date.now().toString(36);
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Backoffice Zola</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><defs><linearGradient id='g' x1='0' y1='1' x2='1' y2='0'><stop offset='0' stop-color='%23fd267a'/><stop offset='1' stop-color='%23ff6036'/></linearGradient></defs><rect width='24' height='24' rx='5' fill='url(%23g)'/><g fill='none' stroke='%23fff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' transform='translate(3.6 3.6) scale(.7)'><path d='M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4'/><path d='M14 13.12c0 2.38 0 6.38-1 8.88'/><path d='M17.29 21.02c.12-.6.43-2.3.5-3.02'/><path d='M2 12a10 10 0 0 1 18-6'/><path d='M2 16h.01'/><path d='M21.8 16c.2-2 .131-5.354 0-6'/><path d='M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2'/><path d='M8.65 22c.21-.66.45-1.32.57-2'/><path d='M9 6.8a6 6 0 0 1 9 5.2v2'/></g></svg>">
  <link rel="preload" href="/fonts/montserrat-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preconnect" href="https://sbsxgwdpdjxsrxcccwno.supabase.co">
  <link rel="stylesheet" href={`/admin.css?v=${cssVersion}`}>
</head>
<body>

  <!-- Connexion -->
  <div class="gate hidden" id="view-gate">
    <div class="gate-card">
      <div class="gate-brand">ZOLA</div>
      <h1>Espace administration</h1>
      <p class="sub">Réservé à l'équipe. Chaque action est enregistrée avec le nom de son auteur.</p>
      <label class="field" for="l-email">Adresse e-mail</label>
      <input type="email" id="l-email" autocomplete="username" style="margin-bottom:12px">
      <label class="field" for="l-password">Mot de passe</label>
      <input type="password" id="l-password" autocomplete="current-password">
      <button class="btn" id="btn-login" style="width:100%;margin-top:18px">Se connecter</button>
      <p class="msg-line err hidden" id="login-msg"></p>
    </div>
  </div>

  <!-- Compte sans droits -->
  <div class="gate hidden" id="view-denied">
    <div class="gate-card">
      <div class="gate-brand">ZOLA</div>
      <h1>Accès refusé</h1>
      <p class="sub">Le compte <b id="denied-email"></b> ne fait pas partie de l'équipe d'administration, ou son accès a été désactivé.</p>
      <button class="btn ghost" id="btn-denied-logout" style="width:100%">Changer de compte</button>
    </div>
  </div>

  <!-- Application -->
  <div class="shell hidden" id="view-app">

    <aside class="sidebar">
      <div class="sidebar-brand">
        <span class="mark" aria-hidden="true"></span>
        <span class="name">ZOLA<small>Backoffice</small></span>
      </div>

      <nav class="nav-group">
        <button class="nav-item" data-page="dashboard">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 13h8V3H3zM13 21h8V11h-8zM3 21h8v-6H3zM13 9h8V3h-8z"/></svg>
          Tableau de bord
        </button>
        <div class="nav-title">Modération</div>
        <button class="nav-item" data-page="safety">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l7 3v5c0 4.4-3 8.4-7 10-4-1.6-7-5.6-7-10V6z"/><path d="M12 9v4M12 16h.01"/></svg>
          Sécurité des enfants
          <span class="count alert hidden" id="nav-count-safety">0</span>
        </button>
        <button class="nav-item" data-page="reports">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21V4h9l.6 2H20v9h-7l-.6-2H4"/></svg>
          Signalements
          <span class="count hidden" id="nav-count-reports">0</span>
        </button>
        <button class="nav-item" data-page="verifications">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l7 3v5c0 4.4-3 8.4-7 10-4-1.6-7-5.6-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
          Vérifications
          <span class="count hidden" id="nav-count-verif">0</span>
        </button>
        <button class="nav-item" data-page="photos">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M4 18l5-4 3 2 3-3 5 5"/></svg>
          Photos
          <span class="count hidden" id="nav-count-photos">0</span>
        </button>
        <div class="nav-title">Communauté</div>
        <button class="nav-item" data-page="users">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 20v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2"/><circle cx="9.5" cy="7" r="3.5"/><path d="M21 20v-2a4 4 0 00-3-3.9"/><path d="M15.5 3.6a4 4 0 010 6.8"/></svg>
          Utilisateurs
        </button>
        <button class="nav-item" data-page="conversation">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H8l-5 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          Conversations
        </button>
        <button class="nav-item" data-page="testers">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/><path d="M8 15l2 2 4-4"/></svg>
          Testeurs
        </button>
        <div class="nav-title">Contenu</div>
        <button class="nav-item" data-page="events">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>
          Soirées
        </button>
        <button class="nav-item" data-page="blog">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h11l5 5v11H4z"/><path d="M8 12h8M8 16h5"/></svg>
          Blog
        </button>
        <div class="nav-title">Contacts</div>
        <button class="nav-item" data-page="mail">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v12H8l-4 4z"/><path d="M8 9h8M8 12h5"/></svg>
          Courrier
          <span class="count hidden" id="nav-count-mail">0</span>
        </button>
        <button class="nav-item" data-page="waitlist">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          Liste d'attente
        </button>
        <div class="nav-title">Équipe et réglages</div>
        <button class="nav-item" data-page="team">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0"/></svg>
          Administrateurs
        </button>
        <button class="nav-item" data-page="audit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 2"/><circle cx="12" cy="12" r="9"/></svg>
          Historique des actions
        </button>
        <button class="nav-item" data-page="guide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5a2 2 0 012-2h13v16H6a2 2 0 00-2 2z"/><path d="M8 7h8M8 11h6"/></svg>
          Guide de modération
        </button>
        <button class="nav-item" data-page="economy">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/><path d="M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>
          Économie
        </button>
      </nav>

      <div class="sidebar-foot">
        Chaque action est enregistrée avec sa date et son auteur.
      </div>
    </aside>

    <div class="nav-backdrop" id="nav-backdrop"></div>

    <div class="main">
      <header class="topbar">
        <button class="icon-btn burger" id="btn-burger" aria-label="Ouvrir le menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <div class="tb-title">
          <div class="tb-crumb" id="page-crumb">Pilotage</div>
          <h1 id="page-title">Tableau de bord</h1>
        </div>
        <div class="spacer"></div>
        <form class="tb-search" id="tb-search" role="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <input type="search" id="tb-search-input" placeholder="Chercher un membre" aria-label="Chercher un membre">
        </form>
        <button class="tb-urgent hidden" id="tb-urgent" type="button"></button>
        <button class="icon-btn" id="btn-refresh" type="button" aria-label="Actualiser" title="Actualiser">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 11a8 8 0 10-2.3 5.7"/><path d="M20 4v7h-7"/></svg>
        </button>
        <div class="account">
          <button class="account-btn" id="account-btn" type="button" aria-haspopup="menu" aria-expanded="false">
            <span class="initials" id="who-initials">·</span>
            <span class="who"><b id="who-email"></b><span id="who-role"></span></span>
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="account-menu hidden" id="account-menu" role="menu">
            <div class="am-head"><b id="menu-email"></b><span id="menu-role"></span></div>
            <button class="am-item" type="button" id="btn-menu-guide" role="menuitem">Guide de modération</button>
            <button class="am-item" type="button" id="btn-menu-audit" role="menuitem">Historique des actions</button>
            <button class="am-item danger" type="button" id="btn-logout" role="menuitem">Déconnexion</button>
          </div>
        </div>
      </header>

      <main class="page" id="page-root"></main>
    </div>
  </div>

  <div id="layer"></div>

  <script>
    // Astro regroupe, réduit et sert ce module depuis /_astro/ avec une
    // empreinte dans le nom : plus de chargement depuis esm.sh.
    import "../scripts/admin.js";
  </script>
</body>
</html>
