  <meta name="description" content="Un article du blog de Zola, l'app de rencontre de la RDC.">
  <meta property="og:site_name" content="Zola">
  <meta property="og:type" content="article">
  <meta property="og:title" content="Article | Blog Zola">
  <meta property="og:description" content="Un article du blog de Zola, l'app de rencontre de la RDC.">
  <meta property="og:image" content="https://zola-rdc.com/og-image.jpg">
  <meta name="twitter:card" content="summary_large_image">
