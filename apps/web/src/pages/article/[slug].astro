---
// Une page HTML par article, écrite à la construction : titre, texte,
// couverture réduite, balises de partage et données pour Google sont déjà
// dans la page. Les aperçus WhatsApp et Facebook montrent enfin la vraie
// couverture de l'article. Même balisage et même CSS que l'ancienne page
// qui fabriquait tout cela dans le navigateur.
import {
  getPosts, coverSet, renderMarkdown, excerptOf, fmtDate, readTime, articlePath,
} from '../../lib/blog.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const cover = await coverSet(post.cover_url);
const excerpt = excerptOf(post);
const canonical = 'https://zola-rdc.com' + articlePath(post.slug);
const ogImage = cover?.og || 'https://zola-rdc.com/og-image.jpg';
const html = renderMarkdown(post.content);
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: excerpt,
  image: ogImage,
  datePublished: post.published_at,
  inLanguage: 'fr',
  mainEntityOfPage: canonical,
  author: { '@type': 'Organization', name: 'Zola', url: 'https://zola-rdc.com/' },
  publisher: { '@type': 'Organization', name: 'Zola', url: 'https://zola-rdc.com/' },
}).replace(/</g, String.fromCharCode(92) + 'u003c');
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{post.title + ' | Blog Zola'}</title>
  <meta name="description" content={excerpt}>
  <link rel="canonical" href={canonical}>
  <meta property="og:site_name" content="Zola">
  <meta property="og:locale" content="fr_CD">
  <meta property="og:type" content="article">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={post.title}>
  <meta property="og:description" content={excerpt}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={post.title}>
  <meta name="twitter:description" content={excerpt}>
  <meta name="twitter:image" content={ogImage}>
  <script type="application/ld+json" set:html={jsonLd}></script>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><defs><linearGradient id='g' x1='0' y1='1' x2='1' y2='0'><stop offset='0' stop-color='%23fd267a'/><stop offset='1' stop-color='%23ff6036'/></linearGradient></defs><rect width='24' height='24' rx='5' fill='url(%23g)'/><g fill='none' stroke='%23fff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' transform='translate(3.6 3.6) scale(.7)'><path d='M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4'/><path d='M14 13.12c0 2.38 0 6.38-1 8.88'/><path d='M17.29 21.02c.12-.6.43-2.3.5-3.02'/><path d='M2 12a10 10 0 0 1 18-6'/><path d='M2 16h.01'/><path d='M21.8 16c.2-2 .131-5.354 0-6'/><path d='M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2'/><path d='M8.65 22c.21-.66.45-1.32.57-2'/><path d='M9 6.8a6 6 0 0 1 9 5.2v2'/></g></svg>">
  <meta name="theme-color" content="#ffffff">
  <link rel="preload" href="/fonts/montserrat-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/theme.css">
  <style is:inline>
    body { line-height: 1.8; font-size: 17px; }
    .topbar {
      display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
      padding: 18px 28px;
      background: #fff;
      border-bottom: 1px solid var(--line);
      position: sticky; top: 0; z-index: 20;
    }
    .logo {
      width: 40px; height: 40px; border-radius: var(--radius);
      background: var(--accent);
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 8px 22px rgba(230, 23, 95, .28);
    }
    .logo svg { width: 22px; height: 22px; }
    .back { justify-self: end; }
    .wrap { max-width: 760px; margin: 0 auto; padding: 52px 24px 90px; }
    .kicker { display: inline-block; margin-bottom: 12px; }
    h1 {
      font-size: clamp(1.9rem, 5vw, 2.9rem);
      font-weight: 800; line-height: 1.15; margin-bottom: 16px;
      color: var(--heading);
    }
    .meta {
      text-transform: uppercase; letter-spacing: .08em; font-weight: 700;
      color: var(--faint); font-size: .72rem; margin-bottom: 30px;
    }
    .cover {
      width: 100%; border-radius: var(--radius); margin-bottom: 38px;
      aspect-ratio: 16 / 9; object-fit: cover;
      background: var(--accent-soft);
      border: 1px solid var(--glass-border);
    }
    .content h2 { font-size: 1.4rem; font-weight: 700; margin: 36px 0 14px; color: var(--heading); }
    .content h3 { font-size: 1.12rem; font-weight: 600; margin: 28px 0 10px; color: var(--heading); }
    .content p { margin-bottom: 18px; color: var(--text); }
    .content ul, .content ol { margin: 0 0 18px 22px; color: var(--text); }
    .content li { margin-bottom: 8px; }
    .content img { max-width: 100%; border-radius: var(--radius); margin: 12px 0; }
    .content a { color: var(--accent); }
    .content blockquote {
      border-left: 3px solid var(--accent);
      padding: 4px 18px; margin: 22px 0;
      color: var(--text);
      background: rgba(255, 255, 255, .7);
      border-radius: 0 var(--radius) var(--radius) 0;
    }
    .content strong { color: var(--heading); }
    .state { text-align: center; color: var(--muted); padding: 90px 20px; }
    .backlink {
      display: inline-block; margin-top: 44px;
      color: var(--accent); text-decoration: none; font-weight: 600;
      border-bottom: 2px solid var(--accent-soft); padding-bottom: 1px;
    }
    .backlink:hover { border-bottom-color: var(--accent); }
    @media (max-width: 600px) {
      body { font-size: 16px; }
      .topbar { padding: 14px 16px; }
      .logo { width: 34px; height: 34px; }
      .logo svg { width: 19px; height: 19px; }
      .wrap { padding: 32px 20px 60px; }
      .cover { margin-bottom: 26px; }
      .content h2 { font-size: 1.22rem; margin: 28px 0 12px; }
    }
  </style>
</head>
<body>
  <nav class="topbar">
    <a class="brand" href="/">ZOLA</a>
    <span class="logo" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"/><path d="M14 13.12c0 2.38 0 6.38-1 8.88"/><path d="M17.29 21.02c.12-.6.43-2.3.5-3.02"/><path d="M2 12a10 10 0 0 1 18-6"/><path d="M2 16h.01"/><path d="M21.8 16c.2-2 .131-5.354 0-6"/><path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2"/><path d="M8.65 22c.21-.66.45-1.32.57-2"/><path d="M9 6.8a6 6 0 0 1 9 5.2v2"/></svg>
    </span>
    <a class="back" href="/blog">Tous les articles</a>
  </nav>

  <div class="wrap">
    <div id="article" class="">
      <p class="kicker">Article</p>
      <h1>{post.title}</h1>
      <p class="meta">{fmtDate(post.published_at) + ' · ' + readTime(post.content)}</p>
      {cover && (
        <img class="cover" src={cover.src} srcset={cover.srcset}
          sizes="(max-width: 760px) 100vw, 712px" alt={post.title}
          loading="eager" fetchpriority="high" decoding="async">
      )}
      <div class="content" set:html={html}></div>
      <a class="backlink" href="/blog">Voir tous les articles</a>
    </div>
  </div>

  <footer>
    <nav class="foot-nav">
      <a href="/blog">Blog</a>
      <a href="/faq">F.A.Q</a>
      <a href="/conditions">Conditions générales</a>
      <a href="/confidentialite">Confidentialité</a>
      <a href="/conseils">Conseils et sécurité</a>
      <a href="/securite-enfants">Sécurité des enfants</a>
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/contact">Contact</a>
    </nav>
    <p class="foot-copy">© 2026 Goblaire Ltd. Tous droits réservés.</p>
  </footer>
</body>
</html>
