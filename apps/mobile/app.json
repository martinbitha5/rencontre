{
  "expo": {
    "name": "Zola",
    "slug": "zola",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zola",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zola.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Zola a besoin d'accéder à vos photos pour créer votre profil."
      }
    },
    "android": {
      "package": "com.zolardc.app",
      "adaptiveIcon": {
        "backgroundColor": "#fd267a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fd267a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zola a besoin d'accéder à vos photos pour créer votre profil.",
          "cameraPermission": "Zola utilise l'appareil photo pour prendre les photos de votre profil, vérifier votre identité et scanner les codes QR des soirées."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#fd267a",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Zola utilise le micro pour envoyer des notes vocales."
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Zola utilise l'appareil photo pour prendre les photos de votre profil, vérifier votre identité et scanner les codes QR des soirées."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zola utilise ta position uniquement pour vérifier ta ville. Ta position exacte n'est jamais partagée."
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "64b0af85-c72a-4d71-beb8-845188b262dc"
      }
    },
    "owner": "martinbitha5"
  }
}
